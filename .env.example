# Environment Variables Example
# Copy this file to .env.development or .env.production and fill in the values

# Site Configuration
GATSBY_SITE_URL=https://digital-security-center.kz
GATSBY_SITE_NAME="ТОО «Центр цифровой безопасности»"

# API Configuration (if backend exists)
GATSBY_API_URL=https://api.digital-security-center.kz
GATSBY_API_TIMEOUT=30000

# Form Submission Endpoint
GATSBY_CONTACT_FORM_ENDPOINT=/api/contact

# Google Analytics (optional)
# GATSBY_GA_TRACKING_ID=UA-XXXXX-Y

# Google Tag Manager (optional)
# GATSBY_GTM_ID=GTM-XXXXX

# Sentry (optional, for error tracking)
# GATSBY_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Error Logging Endpoint (optional)
# If you want to send client-side errors to a custom logging service
# GATSBY_LOG_ENDPOINT=https://your-logging-service.com/api/logs

# Feature Flags (optional)
GATSBY_ENABLE_ANALYTICS=true
GATSBY_ENABLE_CONTACT_FORM=true

# ===================================
# NEVER COMMIT ACTUAL VALUES TO GIT!
# ===================================

# ==============================================
# SMTP Configuration for Netlify Functions
# ==============================================
#
# Бесплатные опции для отправки email:
#
# 1. Gmail SMTP (бесплатно, до 500 emails/день)
#    - Создайте App Password: https://myaccount.google.com/apppasswords
#
# 2. SendGrid Free (100 emails/день бесплатно)
#    - Зарегистрируйтесь: https://signup.sendgrid.com/
#
# 3. Mailgun Free (100 emails/день бесплатно первые 3 месяца)
#    - Зарегистрируйтесь: https://signup.mailgun.com/
#
# ВАЖНО: Добавьте эти переменные в Netlify Environment Variables!
#        Site settings > Environment variables

# ============ ВАРИАНТ 1: Gmail SMTP (РЕКОМЕНДУЕТСЯ) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM=your-email@gmail.com
NOTIFY_EMAIL=info@digital-security-center.kz

# ============ ВАРИАНТ 2: SendGrid ============
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key-here
# SMTP_FROM=your-verified-sender@yourdomain.com
# NOTIFY_EMAIL=info@digital-security-center.kz

# ============ ВАРИАНТ 3: Mailgun ============
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@yourdomain.mailgun.org
# SMTP_PASS=your-mailgun-password
# SMTP_FROM=noreply@yourdomain.com
# NOTIFY_EMAIL=info@digital-security-center.kz

# ==============================================
# Инструкции по настройке Gmail App Password:
# ==============================================
# 1. Включите 2-Step Verification: https://myaccount.google.com/security
# 2. Создайте App Password: https://myaccount.google.com/apppasswords
# 3. Выберите "Mail" и "Other (Custom name)"
# 4. Назовите "DSC Website"
# 5. Скопируйте 16-значный пароль и используйте в SMTP_PASS
# ==============================================

# Database (backend only, NOT for frontend)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dsc_db

# JWT Secret (backend only, NOT for frontend)
# JWT_SECRET=your-super-secret-key

# API Keys (backend only, NOT for frontend)
# API_SECRET_KEY=your-api-secret-key
